# SANCHAY IAS - Environment Configuration
# Copy to .env and adjust values for your environment

# ═══════════════════════════════════════════════════════════════════
# API SERVER CONFIGURATION
# ═══════════════════════════════════════════════════════════════════

# Host and port for API server
API_HOST=0.0.0.0
API_PORT=8001

# Enable auto-reload in development (set to False for production)
API_RELOAD=True

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8000,file://

# ═══════════════════════════════════════════════════════════════════
# DATA INGESTION CONFIGURATION
# ═══════════════════════════════════════════════════════════════════

# Data refresh interval in seconds (3600 = 1 hour)
DATA_REFRESH_INTERVAL=3600

# ═══════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════

# Database path (relative to project root, stored in /data)
# DB_PATH is auto-configured by sanchay_db.py
# DATABASE_URL=sqlite:///data/sanchay_local.db

# ═══════════════════════════════════════════════════════════════════
# LOGGING CONFIGURATION
# ═══════════════════════════════════════════════════════════════════

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ═══════════════════════════════════════════════════════════════════
# DEVELOPMENT / DEBUGGING
# ═══════════════════════════════════════════════════════════════════

# Enable debug mode
DEBUG=False

# Verbose logging
VERBOSE=False
